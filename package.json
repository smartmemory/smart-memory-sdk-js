{
  "name": "@smartmemory/sdk-js",
  "version": "1.4.53",
  "description": "Unified JavaScript SDK for SmartMemory API — auth + API client for all frontends",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "development": "./src/core.js",
      "default": "./dist/core.js"
    },
    "./react": {
      "development": "./src/react/index.js",
      "default": "./dist/react.js"
    },
    "./fetch": {
      "development": "./src/fetch/index.js",
      "default": "./dist/fetch.js"
    },
    "./progress": {
      "development": "./src/progress.ts",
      "default": "./dist/progress.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "smartmemory",
    "sdk",
    "auth",
    "api-client"
  ],
  "license": "MIT",
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-memory/smart-memory-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/smart-memory/smart-memory-sdk-js/issues"
  },
  "homepage": "https://github.com/smart-memory/smart-memory-sdk-js#readme"
}
